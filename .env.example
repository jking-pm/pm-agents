# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — web search provider (enables live company research)
# Set SEARCH_PROVIDER to "tavily" or "brave", then supply the corresponding key.
# If omitted, the agent uses Claude's training knowledge only.
SEARCH_PROVIDER=tavily

# Tavily Search API (recommended) — https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search API (alternative) — https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here
